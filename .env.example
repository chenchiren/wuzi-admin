# 物资管理系统环境变量示例
# 复制为 .env 或注入系统环境变量后启动
# 本机开发可写到 %USERPROFILE%\.wuzi\env（仓库外，不会被提交）

# 数据库
WUZI_DB_URL=jdbc:mysql://localhost:3306/wuzi_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# 业务连接账号（不要用超级管理员，单独建账号并只授必要权限）
WUZI_DB_USER=wuzi_app
WUZI_DB_PASSWORD=change-me
# 仅 docker compose 初始化 MySQL 容器时需要
WUZI_DB_ROOT_PASSWORD=change-me-too

# JWT
WUZI_JWT_SECRET=please-change-this-to-a-long-random-secret-at-least-32-chars
WUZI_JWT_EXPIRE_HOURS=24

# CORS（逗号分隔）
WUZI_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# 企微 / 钉钉（生产请设 false 并配置 corp/agent/secret）
WUZI_WECOM_MOCK=true
WUZI_DINGTALK_MOCK=true
WUZI_WECOM_CORP_ID=
WUZI_WECOM_AGENT_ID=
WUZI_WECOM_SECRET=
WUZI_DINGTALK_APP_KEY=
WUZI_DINGTALK_APP_SECRET=
WUZI_DINGTALK_AGENT_ID=

# 通知外发开关（站内信始终发送；外推另受 sys_config notify.* 控制）
WUZI_NOTIFY_WECOM=false
WUZI_NOTIFY_DINGTALK=false
WUZI_NOTIFY_EMAIL=false
WUZI_NOTIFY_SMS=false

# SMTP 邮件（wuzi.mail.*；mock=true 只记日志不连接）
WUZI_MAIL_ENABLED=false
WUZI_MAIL_HOST=
WUZI_MAIL_PORT=25
WUZI_MAIL_USERNAME=
WUZI_MAIL_PASSWORD=
WUZI_MAIL_FROM=noreply@local
WUZI_MAIL_MOCK=true

# 短信（wuzi.sms.*；provider=noop|http|aliyun，enabled 默认 false）
WUZI_SMS_ENABLED=false
WUZI_SMS_PROVIDER=noop
WUZI_SMS_API_URL=
WUZI_SMS_ACCESS_KEY=
WUZI_SMS_SECRET_KEY=
WUZI_SMS_SIGN_NAME=
WUZI_SMS_TEMPLATE_CODE=

# 登录安全（username+IP 内存限流/锁定）
WUZI_LOGIN_MAX_FAILURES=10
WUZI_LOGIN_WINDOW_MINUTES=5
WUZI_LOGIN_LOCK_MINUTES=5

# 附件存储（local|minio；minio 未装依赖自动降级 local）
WUZI_STORAGE_TYPE=local
WUZI_MINIO_ENDPOINT=
WUZI_MINIO_ACCESS_KEY=
WUZI_MINIO_SECRET_KEY=
WUZI_MINIO_BUCKET=wuzi
WUZI_ATTACH_DIR=

# 智能助手（本地 vLLM，OpenAI 兼容协议；enabled=false 时 /api/ai/** 关闭）
WUZI_AI_ENABLED=true
WUZI_AI_BASE_URL=http://<LLM_HOST>:31511/v1
WUZI_AI_MODEL=qwen3.5-27b
WUZI_AI_API_KEY=
WUZI_AI_TIMEOUT=60
WUZI_AI_MAX_TOKENS=2048
WUZI_AI_HISTORY_ROUNDS=8
WUZI_AI_RPM=10
WUZI_AI_TOOL_ROUNDS=4

# 智能助手向量语义检索（Ollama bge-m3；物资名称第三级兜底）
WUZI_AI_EMBED_ENABLED=true
WUZI_AI_EMBED_URL=http://127.0.0.1:11434/v1
WUZI_AI_EMBED_MODEL=bge-m3
WUZI_AI_EMBED_THRESHOLD=0.60
WUZI_AI_EMBED_TOPK=5
WUZI_AI_EMBED_RELOAD_MS=1800000
